---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import PageHero from '../../components/PageHero.astro';
import CTAWhatsApp from '../../components/CTAWhatsApp.astro';
import RelatedLinks from '../../components/RelatedLinks.astro';
import ResultsSection from '../../components/ResultsSection.astro';
import EditorialImage from '../../components/EditorialImage.astro';
import ImageGallery from '../../components/ImageGallery.astro';
import { guideLinks } from '../../data/navigation';
import { IMAGES, thinHairGallery } from '../../data/images';
import { BRAND } from '../../data/site';
import { breadcrumbSchema, articleSchema } from '../../utils/schema';

const path = '/ince-saca-mikro-kaynak/';
const title = 'İnce Saça Mikro Kaynak';
const description =
  'İnce saça mikro kaynak uygulamasında yoğunluk, tellerin ağırlığı ve yerleştirme stratejisi. 141 renk sisteminde doğal hacim artışı — gerçekçi beklentiler.';

const breadcrumbs = [
  { name: 'Ana Sayfa', path: '/' },
  { name: 'İnce Saça Mikro Kaynak', path },
];
const schemas = [
  breadcrumbSchema(breadcrumbs),
  articleSchema({ title, description, path }),
];
---

<BaseLayout {title} {description} {path} breadcrumbs={breadcrumbs} schemas={schemas}>
  <Breadcrumb items={breadcrumbs} />
  <PageHero
    title="İnce Saça Mikro Kaynak"
    lead="İnce telli saçlarda hacim ve uzunluk hedefi mümkün olabilir; ancak ağırlık kontrolü ve yerleştirme stratejisi belirleyicidir. Abartılı yoğunluk vaatlerinden kaçının."
    image={IMAGES.model2}
  />

  <article class="section">
    <div class="container container--narrow prose">
      <div class="short-answer">
        <p class="short-answer__label">Kısa cevap</p>
        <p>
          İnce saça mikro kaynak uygulanabilir; fakat her profile uygun değildir.
          Tutam ağırlığı, bağlantı konumu ve hedef yoğunluk bireysel olarak
          planlanmalıdır. “Ne kadar çok o kadar iyi” mantığı ince saçta geçerli
          değildir.
        </p>
      </div>

      <h2>İnce saç neden farklı değerlendirilir?</h2>
      <p>
        İnce saç telleri, aynı görünür hacme kıyasla daha az taşıyıcı kapasiteye
        sahip olabilir. Ek tellerin ağırlığı kök bölgesinde hissedilebilir veya
        bağlantı noktaları daha erken yorulabilir. Bu nedenle ince saçta mikro
        kaynak planlanırken kontrollü bir yaklaşım esas alınır.
      </p>

      <EditorialImage image={IMAGES.model2} />

      <h2>Yoğunluk ve ağırlık dengesi</h2>
      <p>
        Hedef sadece uzunluk değilse, kontrollü bir yoğunluk artışı daha doğal
        sonuç verebilir. İnce teller için daha hafif ek saç seçimi, daha küçük
        bağlantı grupları ve stratejik yerleştirme — özellikle yan ve arka
        bölgelerde — önem taşır. Aşırı yükleme, hem konforu hem de görünümü
        olumsuz etkileyebilir.
      </p>

      <h3>Bağlantı konumu</h3>
      <p>
        İnce saçta bağlantıların üst katmanlara yakın yerleştirilmesi görünürlük
        riskini artırır. Deneyimli bir uygulayıcı, tellerin doğal düşüş yönünü
        takip ederek bağlantıları gizler. Mikro kapsül kaynak profili bu açıdan
        avantaj sağlayabilir; fakat yöntem seçimi tek başına yeterli değildir.
      </p>

      <h2>141 renk sistemi ve ince saçta harmanlama</h2>
      <p>
        {BRAND.name} kartelasında {BRAND.colorCount} renk seçeneği bulunur.
        İnce saçta renk eşleştirmesi özellikle kritiktir; çünkü ince teller ışığı
        farklı yansıtabilir ve ton farkı daha belirgin görünebilir. Doğal
        harmanlama, geçiş hattının fark edilmemesi için şarttır.
      </p>

      <h2>Keratin kaynak alternatifi</h2>
      <p>
        Bazı ince saç profillerinde keratin kaynak daha uygun olabilir. Bağlantı
        malzemesinin profili, saçın taşıyabileceği yük ile uyumlu olmalıdır.
        <a href="/mikro-kaynak-mi-keratin-kaynak-mi/">Mikro kaynak mı keratin
        kaynak mı?</a> karşılaştırma rehberimizde yöntem farklarını inceleyebilirsiniz.
      </p>

      <h2>Gramaj ve tutam ağırlığı</h2>
      <p>
        İnce saçta kullanılacak gram miktarı, doğal saçın taşıma kapasitesiyle
        sınırlıdır.
        <a href="/mikro-kaynak-kac-gram-mi-kac-adet-mi/">Gramaj ve adet rehberimizde</a>
        ince telli saçlarda planlamayı ayrıntılı anlattık. Fiyatlandırma mantığı için
        <a href="/mikro-sac-kaynak-fiyatlari/">fiyat rehberimize</a>
        de bakabilirsiniz.
      </p>

      <h2>Bakım alışkanlıkları</h2>
      <p>
        İnce saç genellikle daha hızlı yağlanabilir veya kolay karışabilir.
        Düğüm açma, uyku pozisyonu ve ürün seçimi ince saçta mikro kaynak ömrünü
        doğrudan etkiler. Detaylı bakım önerileri için
        <a href="/mikro-kaynak-bakimi/">bakım rehberimize</a> bakın.
      </p>

      <div class="callout">
        <p>
          İnce saçta abartılı hacim vaatlerinden kaçının. Doğal görünüm ve saç
          bütünlüğü, tek seferde maksimum uzunluktan genellikle daha değerlidir.
        </p>
      </div>
    </div>
  </article>

  <ImageGallery
    title="İnce Saçta Mikro Kaynak Görselleri"
    intro="Gerçek Sach model görselleri — ince telli saç profillerinde kontrollü yoğunluk ve renk uyumu referansı."
    images={thinHairGallery}
    columns={3}
  />

  <ResultsSection
    title="İnce Saçlarda Doğal Sonuç"
    images={thinHairGallery}
  />

  <CTAWhatsApp
    title="İnce saç profiliniz için ön değerlendirme"
    message="Merhaba, ince saçım için mikro kaynak uygunluğu hakkında bilgi almak istiyorum."
  />
  <RelatedLinks links={guideLinks} exclude={path} />
</BaseLayout>
