---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import PageHero from '../../components/PageHero.astro';
import FAQList from '../../components/FAQList.astro';
import FethiyeContactBlock from '../../components/FethiyeContactBlock.astro';
import RelatedLinks from '../../components/RelatedLinks.astro';
import { guideLinks } from '../../data/navigation';
import { BRAND, CONTACT_FETHIYE } from '../../data/site';
import {
  breadcrumbSchema,
  articleSchema,
  faqSchema,
  fethiyeHairSalonSchema,
  type FAQEntry,
} from '../../utils/schema';

const path = CONTACT_FETHIYE.pagePath;
const title = 'Fethiye Mikro Saç Kaynak';
const titleSuffix = `${CONTACT_FETHIYE.brandName} · Mikro Saç Kaynak`;
const description =
  'Fethiye ve Ölüdeniz çevresinde mikro saç kaynak danışmanlığı. Sach & Vogue Hair — 141 renk sistemi, ön analiz ve randevu planlaması. WhatsApp: 0532 592 88 42.';

const breadcrumbs = [
  { name: 'Ana Sayfa', path: '/' },
  { name: 'Fethiye Mikro Saç Kaynak', path },
];

const faqs: FAQEntry[] = [
  {
    question: 'Fethiye\'de mikro saç kaynak fiyatları nasıl belirlenir?',
    answer:
      'Fiyat yalnızca gram üzerinden hesaplanmaz. Doğal saç yoğunluğu, mevcut kesim, hedef uzunluk, seçilen yöntem, tutam ağırlığı, yerleşim stratejisi, işçilik süresi ve bakım alışkanlığınız birlikte değerlendirilir. Ön analiz sonrası makul bir aralık konuşulabilir.',
  },
  {
    question: 'Mikro saç kaynak kısa saça uygulanır mı?',
    answer:
      'Birçok profilde mümkündür; ancak kısa saçta geçiş hattı, kat dengesi ve yoğunluk planlaması ekstra emek gerektirir. Basit gram hesabı yanıltıcı olabilir. Uygunluk bireysel değerlendirme ile belirlenir.',
  },
  {
    question: 'İnce saçta mikro saç kaynak zararlı mı?',
    answer:
      'Yöntem tek başına zararlı değildir; risk, aşırı ağırlık, yanlış yerleşim veya yetersiz bakımdan doğabilir. İnce saçta tutam ağırlığı ve bağlantı noktaları özellikle dikkatle planlanmalıdır. Herkese uygun değildir.',
  },
  {
    question: 'Mikro saç kaynak ne kadar süre kullanılır?',
    answer:
      'Kullanım süresi bakım disiplininize, saç büyüme hızınıza ve günlük alışkanlıklarınıza bağlıdır. Kesin ay garantisi vermek doğru değildir. Düzenli kontrol seansları görünümü ve konforu korumaya yardımcı olur.',
  },
  {
    question: 'Mikro saç kaynak yaptırmadan önce fotoğraf göndermek gerekir mi?',
    answer:
      'Zorunlu değildir ancak gündüz ışığında çekilmiş güncel saç fotoğrafları ön analizi hızlandırır. Mevcut uzunluk, yoğunluk ve hedefinizi mesajla birlikte paylaşmanız yeterli bir başlangıç olur.',
  },
  {
    question: 'Mikro saç kaynak ile keratin kaynak arasında ne fark var?',
    answer:
      'Mikro saç kaynak küçük bağlantı noktası hedefler; keratin kaynak ergimiş keratin boncuğu kullanır. Profil, konfor ve bakım ihtiyacı farklıdır. Hangisinin uygun olduğu saç yapınıza göre değişir; tek doğru yöntem yoktur.',
  },
  {
    question: 'Ölüdeniz çevresinden danışmanlık alınabilir mi?',
    answer:
      'Evet. Ölüdeniz ve Fethiye çevresinde ikamet eden veya bölgeye gelen ziyaretçiler, aynı danışmanlık hattı üzerinden WhatsApp ile ön analiz talep edebilir. Yüz yüze uygulama planı varsa detaylar görüşmede netleşir.',
  },
];

const schemas = [
  breadcrumbSchema(breadcrumbs),
  articleSchema({ title, description, path }),
  fethiyeHairSalonSchema(),
  faqSchema(faqs),
];

const fethiyeWhatsappMessage =
  'Merhaba, Fethiye merkezinizden mikro saç kaynak hakkında danışmanlık almak istiyorum. Gündüz ışığında saç fotoğrafımı paylaşabilirim; ön analiz ve randevu planlaması hakkında bilgi almak istiyorum.';
---

<BaseLayout
  {title}
  {titleSuffix}
  {description}
  {path}
  breadcrumbs={breadcrumbs}
  schemas={schemas}
>
  <Breadcrumb items={breadcrumbs} />
  <PageHero
    title="Fethiye Mikro Saç Kaynak"
    lead={`${CONTACT_FETHIYE.regionNote} mikro saç kaynak danışmanlığı — ${CONTACT_FETHIYE.brandName} markası altında ön analiz, yöntem seçimi ve doğal geçiş planlaması.`}
  />

  <article class="section">
    <div class="container container--narrow prose">
      <div class="short-answer">
        <p class="short-answer__label">Kısa cevap</p>
        <p>
          {CONTACT_FETHIYE.brandName}, Fethiye'de {BRAND.colorCount} renk
          sisteminde mikro saç kaynak danışmanlığı ve uygulaması sunar. Ön analiz
          WhatsApp ({CONTACT_FETHIYE.phoneDisplay}) üzerinden başlatılabilir;
          nihai plan yüz yüze değerlendirme ile netleşir.
        </p>
      </div>

      <h2>Giriş</h2>
      <p>
        Bölgede mikro saç kaynak yaptırmadan önce yalnızca fiyat veya gram
        karşılaştırmasına odaklanmak, çoğu zaman yanıltıcı sonuç doğurur.
        Profesyonel ön analiz; saç yoğunluğunuz, mevcut kesiminiz, hedef
        uzunluğunuz ve günlük yaşam tarzınız bir arada değerlendirildiğinde
        anlamlıdır. Doğru yöntem seçimi ve doğal geçiş planlaması, hem
        görünüm hem de bakım sürecinin sürdürülebilirliği için belirleyicidir.
      </p>
      <p>
        Bu sayfa, Fethiye ve Ölüdeniz çevresinden gelen müşteriler için ön analiz
        ve randevu planlaması odaklıdır. Abartılı vaatler veya garanti iddiaları
        yerine gerçekçi beklenti yönetimi esas alınır. Karar vermeden önce
        <a href="/mikro-sac-kaynak/">mikro saç kaynak</a> pillar rehberimizi
        okumanız faydalı olur.
      </p>

      <h2>Fethiye'de mikro saç kaynak yaptırmadan önce nelere dikkat edilmeli?</h2>
      <p>
        Mikro saç kaynak her saç profiline aynı şekilde uygulanmaz. Değerlendirme
        öncesinde şu başlıklar netleştirilmelidir:
      </p>
      <ul>
        <li>
          <strong>Saç yoğunluğu:</strong> Seyrek veya ince telli yapılarda ağırlık
          kontrolü kritiktir.
        </li>
        <li>
          <strong>Mevcut kesim:</strong> Katmanlar, geçiş hattının nerede
          gizleneceğini belirler.
        </li>
        <li>
          <strong>Hedef uzunluk:</strong> Tek seansta iddialı dönüşüm her zaman
          uygun olmayabilir.
        </li>
        <li>
          <strong>Saç tel yapısı:</strong> İnce, normal veya kalın teller farklı
          tutam ağırlığı gerektirir.
        </li>
        <li>
          <strong>Yaşam tarzı:</strong> Deniz, güneş, yüzme ve spor rutini bakım
          planını etkiler — Ölüdeniz çevresinde yaz aylarında bu özellikle
          önem taşır.
        </li>
      </ul>
      <p>
        Uygunluk kriterleri için
        <a href="/mikro-kaynak-kimlere-uygundur/">kimlere uygundur</a>
        sayfamıza da göz atabilirsiniz.
      </p>

      <h2>Mikro saç kaynak fiyatları Fethiye'de neden kişiye göre değişir?</h2>
      <p>
        Saç kaynak merkezi tekliflerinde gram fiyatı karşılaştırmayı kolaylaştırır;
        oysa nihai maliyet çoğu zaman planlama ve işçilikle şekillenir. Aynı
        gramaj, farklı saç profillerinde farklı emek gerektirebilir.
      </p>
      <p>Fiyatı etkileyen başlıca faktörler:</p>
      <ul>
        <li>Doğal saç yoğunluğu</li>
        <li>Mevcut saç kesimi</li>
        <li>Hedef uzunluk</li>
        <li>Kullanılacak yöntem (mikro kapsül, keratin, nanofilament)</li>
        <li>Tutam ağırlığı</li>
        <li>Yerleşim stratejisi</li>
        <li>İşçilik süresi</li>
        <li>Bakım alışkanlığı ve yenileme döngüsü</li>
      </ul>
      <p>
        Genel fiyatlandırma mantığı
        <a href="/mikro-sac-kaynak-fiyatlari/">fiyat rehberimizde</a> ayrıntılı
        anlatılır. Bölgede de aynı prensipler geçerlidir.
      </p>

      <h2>Kısa saçta mikro saç kaynak neden daha fazla planlama ister?</h2>
      <p>
        Kısa saç transformasyonları basit bir gram hesabı değildir. Geçiş hattı,
        kat dengesi ve yoğunluk planlaması birlikte ele alınmalıdır. Yanlış
        uzunlukta veya ağırlıkta teller omuz hizasında doğal olmayan bir basamak
        oluşturabilir.
      </p>
      <p>
        Ayrıntılar için
        <a href="/kisa-saca-mikro-kaynak/">kısa saça mikro kaynak</a>
        rehberimize bakın.
      </p>

      <h2>İnce saçta mikro saç kaynak uygun mu?</h2>
      <p>
        Herkese uygun değildir. İnce telli saçlarda tutam ağırlığı ve bağlantı
        noktalarının konumu bireysel olarak değerlendirilmelidir. Aşırı yoğunluk
        veya ağır teller hem konforu hem görünümü olumsuz etkileyebilir.
      </p>
      <p>
        <a href="/ince-saca-mikro-kaynak/">İnce saça mikro kaynak</a>
        rehberimizde bu konuyu genişlettik.
      </p>

      <h2>Mikro saç kaynak mı, keratin kaynak mı?</h2>
      <p>
        İki yöntem de saç uzatma amacı taşır; fark bağlantı profili, konfor ve
        bakım ihtiyacında ortaya çıkar. Nanofilament de üçüncü bir alternatif
        olarak değerlendirilebilir. “En iyi yöntem budur” demek yerine, saç
        yapınıza göre seçim yapılmalıdır.
      </p>
      <p>
        Tarafsız karşılaştırma için
        <a href="/mikro-kaynak-mi-keratin-kaynak-mi/">mikro kaynak mı keratin mi?</a>
        sayfamızı inceleyin.
      </p>

      <h2>{CONTACT_FETHIYE.brandName} — merkez ve iletişim</h2>
      <p>
        {CONTACT_FETHIYE.brandName}, {BRAND.colorCount} renk sisteminde doğal
        saç rengiyle uyumlu harmanlama hedefleyen mikro saç kaynak hizmeti sunar.
        Ön analiz ve randevu planlaması için aşağıdaki merkez bilgilerini
        kullanabilirsiniz. Fethiye / Ölüdeniz çevresinden gelen müşteriler
        gündüz ışığında saç fotoğrafı paylaşarak görüşmeyi hızlandırabilir.
      </p>

      <FethiyeContactBlock whatsappMessage={fethiyeWhatsappMessage} />

      <h2>Sık sorulan sorular</h2>
      <FAQList faqs={faqs} />
    </div>
  </article>

  <RelatedLinks links={guideLinks} exclude={path} />
</BaseLayout>
