---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import PageHero from '../components/PageHero.astro';
import CTAWhatsApp from '../components/CTAWhatsApp.astro';
import RelatedLinks from '../components/RelatedLinks.astro';
import ResultsSection from '../components/ResultsSection.astro';
import { guideLinks } from '../data/navigation';
import { IMAGES, applicationGallery } from '../data/images';
import { BRAND, PILLAR_PATH } from '../data/site';
import { websiteSchema, breadcrumbSchema } from '../utils/schema';

const path = '/';
const title = 'Mikro Saç Kaynak Rehberi';
const description =
  'Mikro saç kaynak hakkında Türkiye\'nin kapsamlı uzman rehberi. Yöntem, fiyat mantığı, kısa ve ince saç planlaması, bakım ve Fethiye danışmanlık.';

const breadcrumbs = [{ name: 'Ana Sayfa', path: '/' }];
const schemas = [websiteSchema(), breadcrumbSchema(breadcrumbs)];
const heroImage = IMAGES.mikroDogalGorunum;
---

<BaseLayout {title} {description} {path} breadcrumbs={breadcrumbs} schemas={schemas}>
  <Breadcrumb items={breadcrumbs} />
  <PageHero
    title="Mikro Saç Kaynak Rehberi"
    lead="Mikro saç kaynak yalnızca küçük tutamlı bir uzatma yöntemi değildir. Doğal yoğunluk, tel taşıma kapasitesi, tutam ağırlığı, yerleşim planı ve bakım disiplini birlikte değerlendirilmelidir."
    image={heroImage}
  />

  <section class="section">
    <div class="container container--narrow prose">
      <div class="short-answer">
        <p class="short-answer__label">Kısa cevap</p>
        <p>
          Mikro saç kaynak, doğal saç tellerine ince tutamlarla bağlanan bir saç
          uzatma yöntemidir. Doğru sonuç; gram hesabından çok saç analizi, yerleşim
          stratejisi ve gerçekçi bakım planıyla mümkün olur.
          <a href={PILLAR_PATH}>Detaylı pillar rehber</a> tüm konuları kapsar.
        </p>
      </div>

      <h2>Neden bu rehber?</h2>
      <p>
        mikrosackaynak.com, mikro saç kaynak konusuna odaklanan uzman bir bilgi
        kaynağıdır. {BRAND.name} deneyimi ve Fethiye / Ölüdeniz hizmet merkezi
        perspektifiyle; fiyat, uygunluk, kısa saç dönüşümü ve yöntem seçimini
        sakin, gerçekçi bir dille anlatırız.
      </p>

      <h2>Uzmanlık mesajı</h2>
      <p>
        Mikro saç kaynak kararı; mevcut kesim, hedef uzunluk, tellerin inceliği,
        ense yoğunluğu ve günlük bakım alışkanlıklarınızla birlikte ele alınmalıdır.
        {BRAND.colorNote} Kesin vaatler yerine kişiye özel danışmanlık sunuyoruz.
      </p>

      <h2>Gram ve adet planlaması</h2>
      <p>
        Mikro saç kaynak kararı verirken yalnızca fiyat değil, kaç gram ve kaç adet
        gerektiği de merak edilir. Bu iki kavram birbirinden ayrı okunmamalıdır —
        <a href="/mikro-kaynak-kac-gram-mi-kac-adet-mi/">gramaj ve adet rehberimiz</a>
        konuyu baştan sona açıklar.
      </p>

      <h2>İlk adım: pillar rehber</h2>
      <p>
        Tüm konuların merkezi
        <a href={PILLAR_PATH}>mikro saç kaynak rehberi</a>
        sayfasıdır. Uygunluk, gramaj mantığı, yöntem farkları ve sık sorulan
        sorular orada toplanmıştır.
      </p>
    </div>
  </section>

  <ResultsSection images={applicationGallery} />

  <section class="section section--muted">
    <div class="container">
      <h2 class="section-title">Rehber içeriği</h2>
      <div class="card-grid">
        {
          guideLinks.map((link) => (
            <article class="card">
              <h3 class="card__title">
                <a href={link.href}>{link.label}</a>
              </h3>
              {link.description && <p class="card__desc">{link.description}</p>}
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <CTAWhatsApp
    title="Karar vermeden önce sorularınızı netleştirin"
    text="Saç yapınız, hedeflediğiniz uzunluk ve bakım rutininiz hakkında kısa bir ön görüşme, doğru yöntemi seçmenize yardımcı olur."
  />

  <RelatedLinks links={guideLinks} exclude={path} />
</BaseLayout>
