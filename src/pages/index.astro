---
import BaseLayout from '../layouts/BaseLayout.astro';
import SplitHero from '../components/SplitHero.astro';
import TrustStrip from '../components/TrustStrip.astro';
import VisualStatement from '../components/VisualStatement.astro';
import GuideCards from '../components/GuideCards.astro';
import HairTypeGrid from '../components/HairTypeGrid.astro';
import AnalysisSteps from '../components/AnalysisSteps.astro';
import LocalShowcase from '../components/LocalShowcase.astro';
import MiniFAQ from '../components/MiniFAQ.astro';
import PremiumCTA from '../components/PremiumCTA.astro';
import { guideLinks } from '../data/navigation';
import { IMAGES } from '../data/images';
import { BRAND, PILLAR_PATH, whatsappUrl } from '../data/site';
import { websiteSchema, breadcrumbSchema } from '../utils/schema';

const path = '/';
const title = 'Mikro Saç Kaynak Rehberi';
const description =
  'Mikro saç kaynak hakkında Türkiye\'nin kapsamlı uzman rehberi. Yöntem, fiyat mantığı, kısa ve ince saç planlaması, bakım ve Fethiye danışmanlık.';

const breadcrumbs = [{ name: 'Ana Sayfa', path: '/' }];
const schemas = [websiteSchema(), breadcrumbSchema(breadcrumbs)];

const trustItems = [
  { label: 'Hizmet merkezi', value: 'Fethiye / Ölüdeniz' },
  { label: 'Renk sistemi', value: `${BRAND.colorCount} renk` },
  { label: 'Ön değerlendirme', value: 'Fotoğrafla analiz' },
  { label: 'Saç kalitesi', value: 'Premium insan saçı' },
];

const hairTypes = [
  {
    title: 'Kısa saça mikro kaynak',
    text: 'Geçiş hattı, katman ve yoğunluk planlaması — kısa saçta dönüşüm stratejisi.',
    href: '/kisa-saca-mikro-kaynak/',
    image: IMAGES.kisaSacDonusum,
  },
  {
    title: 'İnce saça mikro kaynak',
    text: 'Taşıma kapasitesi ve hafif tutam profili — ince telli saçlarda kontrollü yoğunluk.',
    href: '/ince-saca-mikro-kaynak/',
    image: IMAGES.model2,
  },
  {
    title: 'Kaç gram mı, kaç adet mi?',
    text: 'Gramaj ve adet birbirinden ayrı okunmamalı — amiral planlama rehberi.',
    href: '/mikro-kaynak-kac-gram-mi-kac-adet-mi/',
    image: IMAGES.gramAdetHero,
  },
  {
    title: 'Fiyatlar neye göre değişir?',
    text: 'Gram dışı faktörler: işçilik, harmanlama, saç kalitesi ve bakım döngüsü.',
    href: '/mikro-sac-kaynak-fiyatlari/',
    image: IMAGES.renkUyumu,
  },
];

const analysisSteps = [
  {
    title: 'Gündüz ışığında fotoğraf gönderin',
    text: 'Ön, yan ve arka açıdan güncel saç fotoğraflarınızı WhatsApp üzerinden iletin. Filtresiz çekimler renk eşleştirmesi için daha doğru sonuç verir.',
  },
  {
    title: 'Uzman ön analizi',
    text: 'Saç yoğunluğu, kesim katmanları, hedef uzunluk ve bakım alışkanlıklarınız birlikte değerlendirilir. Yaklaşık gram ve adet çerçevesi oluşturulur.',
  },
  {
    title: 'Kişisel plan oluşturun',
    text: 'Tutam ağırlığı, yerleşim stratejisi ve yöntem seçimi netleştirilir. Fethiye merkezinde yüz yüze veya WhatsApp ile devam edebilirsiniz.',
  },
];

const miniFaqs = [
  {
    question: 'Mikro saç kaynak kimler için uygundur?',
    answer:
      'Mevcut saç yoğunluğu, tellerin inceliği, hedef uzunluk ve bakım disiplini birlikte değerlendirilmelidir. Tek bir profil tüm adaylar için geçerli değildir.',
  },
  {
    question: '150 veya 200 adet yeterli mi?',
    answer:
      'Adet sayısı tek başına sonuç garantisi vermez. Tutam ağırlığı, toplam gramaj ve yerleşim planı birlikte okunmalıdır.',
  },
  {
    question: 'Fiyat yalnızca grama göre mi hesaplanır?',
    answer:
      'Hayır. İşçilik süresi, harmanlama, saç kalitesi, yenileme döngüsü ve planlama karmaşıklığı maliyeti etkiler.',
  },
  {
    question: 'Fethiye dışından danışmanlık alabilir miyim?',
    answer:
      'Evet. Türkiye genelinde WhatsApp hattı üzerinden fotoğrafla ön analiz talep edebilirsiniz.',
  },
];
---

<BaseLayout {title} {description} {path} breadcrumbs={breadcrumbs} schemas={schemas}>
  <SplitHero
    title="Mikro Saç Kaynak Rehberi"
    lead="Mikro saç kaynak yalnızca küçük tutamlı bir uzatma yöntemi değildir. Doğal yoğunluk, tel taşıma kapasitesi, tutam ağırlığı, yerleşim planı ve bakım disiplini birlikte değerlendirilmelidir."
    image={IMAGES.mikroDogalGorunum}
    badge="Sach & Vogue Hair — gerçek model çekimi, AI üretimi değil"
    primaryCta={{
      label: 'WhatsApp Ön Analiz',
      href: whatsappUrl(),
    }}
    secondaryCta={{
      label: 'Pillar rehberi oku',
      href: PILLAR_PATH,
    }}
  />

  <TrustStrip items={trustItems} />

  <VisualStatement
    quote="200 adet her zaman aynı sonucu vermez."
    text="Aynı adet sayısı; farklı tutam ağırlıkları, farklı saç profilleri ve farklı yerleşim planlarıyla tamamen farklı sonuçlar üretebilir. Mikro kaynak kararında gramaj, adet ve bölgesel dağılım birlikte okunmalıdır."
    image={IMAGES.model3}
    ctaLabel="Gramaj ve adet rehberi"
    ctaHref="/mikro-kaynak-kac-gram-mi-kac-adet-mi/"
    reverse
  />

  <GuideCards links={guideLinks} />

  <HairTypeGrid items={hairTypes} />

  <AnalysisSteps steps={analysisSteps} />

  <LocalShowcase image={IMAGES.mikroDogalGorunum} />

  <MiniFAQ faqs={miniFaqs} />

  <PremiumCTA
    title="Karar vermeden önce net bir plan oluşturun"
    text={`${BRAND.name} uzmanlığında fotoğrafla ön analiz ile saç profilinize uygun mikro kaynak planını birlikte değerlendirelim.`}
  />
</BaseLayout>
