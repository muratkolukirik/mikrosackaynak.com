---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import PageHero from '../components/PageHero.astro';
import CTAWhatsApp from '../components/CTAWhatsApp.astro';
import RelatedLinks from '../components/RelatedLinks.astro';
import { guideLinks } from '../data/navigation';
import { breadcrumbSchema, articleSchema } from '../utils/schema';

const path = '/mikro-kaynak-fiyatlari/';
const title = 'Mikro Kaynak Fiyatları Neye Göre Değişir?';
const description =
  'Saç kaynak fiyatları neden sadece grama göre hesaplanmaz? Mikro kaynak maliyetini belirleyen işçilik, harmanlama, saç kalitesi ve bakım faktörleri.';

const breadcrumbs = [
  { name: 'Ana Sayfa', path: '/' },
  { name: 'Fiyatlar Neye Göre Değişir?', path },
];
const schemas = [
  breadcrumbSchema(breadcrumbs),
  articleSchema({ title, description, path }),
];
---

<BaseLayout {title} {description} {path} breadcrumbs={breadcrumbs} schemas={schemas}>
  <Breadcrumb items={breadcrumbs} />
  <PageHero
    title="Mikro Kaynak Fiyatları Neye Göre Değişir?"
    lead="Gram fiyatı karşılaştırmayı kolaylaştırır; ancak nihai maliyet çoğu zaman planlama, işçilik ve saç profilinize bağlıdır."
  />

  <article class="section">
    <div class="container container--narrow prose">
      <h2>Gram fiyatı tek başına yeterli değil</h2>
      <p>
        Piyasada saç kaynak fiyatları sıklıkla gram başına sunulur. Bu, farklı
        teklifleri hızlıca kıyaslamanızı sağlar. Oysa aynı gramaj; kısa saçta
        farklı, uzun saçta farklı bir işçilik gerektirebilir. Kısa saç
        dönüşümlerinde harmanlama ve katman ayarı, malzeme maliyetinden daha
        baskın olabilir.
      </p>

      <h2>Maliyeti etkileyen temel faktörler</h2>

      <h3>1. Mevcut saç uzunluğu ve hedef</h3>
      <p>
        Başlangıç uzunluğu kısaldıkça geçiş planlaması zorlaşır. Omuz altına
        geçiş ile bel hizasına geçiş aynı emek ve süreyi gerektirmez. Hedef
        ne kadar iddialıysa, planlama ve uygulama o kadar detaylı olabilir.
      </p>

      <h3>2. Saç yoğunluğu ve tellerin ağırlığı</h3>
      <p>
        İnce saçta daha hafif teller tercih edilirken, yoğun saçta farklı bir
        yerleştirme stratejisi uygulanabilir. Tellerin kalitesi, kaynağı ve
        işlenme düzeyi fiyatı etkiler — ancak pahalı saç her profilde gerekli
        değildir.
      </p>

      <h3>3. Uygulama süresi ve uzmanlık</h3>
      <p>
        Mikro kaynak uygulaması zaman alıcı bir iştir. Bağlantı noktalarının
        düzenli, konforlu ve gizli olması deneyim gerektirir. Uzun uygulama
        süreleri doğrudan işçilik maliyetine yansır.
      </p>

      <h3>4. Yöntem seçimi</h3>
      <p>
        Mikro kapsül kaynak, keratin kaynak ve nanofilament kaynak farklı malzeme
        ve süreç maliyetlerine sahip olabilir. Doğru yöntem, en ucuz teklif değil;
        profilinize en uygun ve sürdürülebilir olandır.
      </p>

      <h3>5. Bakım ve yenileme döngüsü</h3>
      <p>
        İlk uygulama tek seferlik bir harcama değildir. Periyodik bakım,
        düzeltme ve yenileme seansları toplam maliyetin önemli bir parçasını
        oluşturur. Uzun vadeli bütçe planı yaparken bunu göz ardı etmeyin.
      </p>

      <h2>Şeffaf teklif almak için</h2>
      <p>
        Güvenilir bir fiyatlandırma; kullanılan saç kalitesi, tahmini gram aralığı,
        uygulama süresi, bakım aralığı ve garanti iddiası olmadan net beklenti
        sunmayı içermelidir. “Herkese aynı paket” yaklaşımı genellikle kişisel
        ihtiyaçları yansıtmaz.
      </p>

      <div class="callout">
        <p>
          Bu sayfada sabit bir fiyat listesi paylaşmıyoruz; çünkü her saç profili
          farklıdır. WhatsApp üzerinden kısa bir ön bilgi ile size özel bir aralık
          hakkında yönlendirme alabilirsiniz. Fethiye ve Ölüdeniz bölgesi için
          <a href="/fethiye-mikro-kaynak-sac-merkezi/">lokal fiyatlandırma rehberimiz</a>
          de aynı mantığı anlatır.
        </p>
      </div>
    </div>
  </article>

  <CTAWhatsApp
    title="Size özel fiyat aralığı için yazın"
    message="Merhaba, mikro kaynak fiyatlandırması hakkında bilgi almak istiyorum."
  />
  <RelatedLinks links={guideLinks} exclude={path} />
</BaseLayout>
