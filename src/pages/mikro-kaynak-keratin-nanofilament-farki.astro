---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import PageHero from '../components/PageHero.astro';
import CTAWhatsApp from '../components/CTAWhatsApp.astro';
import RelatedLinks from '../components/RelatedLinks.astro';
import { guideLinks } from '../data/navigation';
import { breadcrumbSchema, articleSchema } from '../utils/schema';

const path = '/mikro-kaynak-keratin-nanofilament-farki/';
const title = 'Mikro Kaynak, Keratin Kaynak ve Nanofilament Farkı';
const description =
  'Mikro kaynak, keratin kaynak ve nanofilament kaynak arasındaki farklar. Bağlantı profili, konfor, bakım ve hangi saç tipine daha uygun?';

const breadcrumbs = [
  { name: 'Ana Sayfa', path: '/' },
  { name: 'Yöntem Farkları', path },
];
const schemas = [
  breadcrumbSchema(breadcrumbs),
  articleSchema({ title, description, path }),
];
---

<BaseLayout {title} {description} {path} breadcrumbs={breadcrumbs} schemas={schemas}>
  <Breadcrumb items={breadcrumbs} />
  <PageHero
    title="Mikro Kaynak, Keratin Kaynak ve Nanofilament Farkı"
    lead="Üç yöntem de saç uzatma amacı taşır; fark bağlantı malzemesinde, profilinde ve bakım ihtiyacında ortaya çıkar."
  />

  <article class="section">
    <div class="container container--narrow prose">
      <h2>Karşılaştırma özeti</h2>
      <p>
        Yöntem seçimi kişiseldir. Aşağıdaki tablo genel eğilimleri özetler; nihai
        karar saç analizi ile verilmelidir.
      </p>

      <div class="comparison-table" role="region" aria-label="Yöntem karşılaştırması">
        <table>
          <thead>
            <tr>
              <th scope="col">Özellik</th>
              <th scope="col">Mikro kaynak</th>
              <th scope="col">Keratin kaynak</th>
              <th scope="col">Nanofilament kaynak</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <th scope="row">Bağlantı profili</th>
              <td>Küçük kapsül / mikro bağ</td>
              <td>Ergimiş keratin boncuk</td>
              <td>İnce film veya nano bağ</td>
            </tr>
            <tr>
              <th scope="row">Görünürlük</th>
              <td>İnce profil hedeflenir</td>
              <td>Bağ noktası daha belirgin olabilir</td>
              <td>Genellikle düz ve ince profil</td>
            </tr>
            <tr>
              <th scope="row">Uygulama süresi</th>
              <td>Orta–uzun</td>
              <td>Orta</td>
              <td>Değişken</td>
            </tr>
            <tr>
              <th scope="row">Bakım</th>
              <td>Düzenli kontrol gerekir</td>
              <td>Periyodik düzeltme</td>
              <td>Yönteme göre farklı</td>
            </tr>
          </tbody>
        </table>
      </div>

      <h2>Mikro kaynak (mikro kapsül kaynak)</h2>
      <p>
        Küçük bağlantı noktalarıyla uygulanır. Düzenli ve ince bir profil hedefleyen
        kişiler tarafından tercih edilebilir. Bağlantıların konumu ve tellerin
        ağırlığı doğru ayarlanmazsa konfor etkilenebilir. Detaylı tanım için
        <a href="/mikro-kaynak-nedir/">mikro kaynak nedir</a> sayfamıza bakın.
      </p>

      <h2>Keratin kaynak</h2>
      <p>
        Ergimiş keratin ile oluşturulan boncuk veya damla bağlantılar kullanılır.
        Uygulama süreci farklıdır; bağ noktası profili mikro kaynaktan genellikle
        daha belirgindir. Bazı saç tiplerinde güvenilir ve ekonomik bir seçenek
        olabilir; ince saçta profil değerlendirmesi özellikle önemlidir.
      </p>

      <h2>Nanofilament kaynak</h2>
      <p>
        İnce bir film veya nano ölçekli bağlantı elemanı kullanan yöntemlerdir.
        Düz profil hedefleyen uygulamalarda tercih edilebilir. Malzeme ve uygulama
        tekniği markaya göre değişir; genelleme yapmak yerine spesifik ürün ve
        uzman deneyimini sorgulamak gerekir.
      </p>

      <h2>Hangisini seçmeliyim?</h2>
      <p>
        Doğal saç yoğunluğu, kesim, hedef uzunluk, tellerin ağırlığı, yerleştirme
        stratejisi ve bakım alışkanlıklarınız birlikte değerlendirilmelidir. Tek
        bir yöntemi “herkes için en iyisi” olarak sunmak doğru değildir.
        <a href="/mikro-kaynak-kimlere-uygundur/">Uygunluk kriterlerimizi</a>
        okuyarak kendi profilinize yakın senaryoları inceleyebilirsiniz.
      </p>

      <div class="callout">
        <p>
          Yöntem seçiminde fiyat tek kriter olmamalıdır. Yanlış yöntem; erken kopma,
          rahatsızlık veya doğal olmayan görünümle ek maliyet doğurabilir.
        </p>
      </div>
    </div>
  </article>

  <CTAWhatsApp
    title="Size uygun yöntemi birlikte belirleyelim"
    message="Merhaba, mikro kaynak ile keratin/nanofilament arasındaki fark hakkında danışmanlık almak istiyorum."
  />
  <RelatedLinks links={guideLinks} exclude={path} />
</BaseLayout>

<style>
  .comparison-table {
    overflow-x: auto;
    margin: var(--space-lg) 0;
  }

  table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.9375rem;
  }

  th,
  td {
    padding: 0.875rem 1rem;
    text-align: left;
    border-bottom: 1px solid var(--color-border-subtle);
    vertical-align: top;
  }

  thead th {
    font-family: var(--font-serif);
    font-weight: 500;
    background: var(--color-bg-muted);
  }

  tbody th[scope='row'] {
    font-weight: 500;
    color: var(--color-text);
    background: var(--color-bg-elevated);
  }
</style>
