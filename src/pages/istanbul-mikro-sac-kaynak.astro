---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import PageHero from '../components/PageHero.astro';
import FAQList from '../components/FAQList.astro';
import RelatedLinks from '../components/RelatedLinks.astro';
import { guideLinks } from '../data/navigation';
import {
  CONTACT_ISTANBUL,
  CONTACT_GENERAL,
  CONTACT_FETHIYE,
  telUrl,
  whatsappUrl,
} from '../data/site';
import {
  breadcrumbSchema,
  articleSchema,
  faqSchema,
  type FAQEntry,
} from '../utils/schema';

const path = '/istanbul-mikro-sac-kaynak/';
const title = 'İstanbul Mikro Saç Kaynak Uygulaması';
const description =
  'İstanbul\'da mikro saç kaynak ve profesyonel saç kaynak uygulaması arayanlar için yöntem seçimi, uygunluk, fiyat mantığı ve iletişim rehberi.';

const breadcrumbs = [
  { name: 'Ana Sayfa', path: '/' },
  { name: 'İstanbul Mikro Saç Kaynak', path },
];

const faqs: FAQEntry[] = [
  {
    question: 'İstanbul\'da mikro saç kaynak için ön görüşme gerekli mi?',
    answer:
      'Yüz yüze veya detaylı fotoğraflarla yapılan ön değerlendirme, yöntem seçimi ve gerçekçi planlama için önemlidir. Mesajla kısa bilgi alınabilir; nihai karar saç analizi sonrası netleşir.',
  },
  {
    question: 'Mikro kaynak mı keratin kaynak mı daha uygun olur?',
    answer:
      'Tek bir yanıt yoktur. Saç yoğunluğu, kesim, hedef uzunluk, tellerin ağırlığı ve bakım alışkanlıklarınıza göre değişir. İnce saçta ağırlık kontrolü, kısa saçta harmanlama planı belirleyicidir.',
  },
  {
    question: 'Fiyat teklifi neden telefonda net verilmeyebilir?',
    answer:
      'Maliyet yalnızca gram fiyatına bağlı değildir. Mevcut uzunluk, hedef görünüm, işçilik süresi ve yenileme döngüsü birlikte hesaplanır. Ön bilgi sonrası makul bir aralık paylaşılabilir; kesin rakam planlama sonrası netleşir.',
  },
  {
    question: 'Kısa veya ince saçta uygulama mümkün mü?',
    answer:
      'Birçok profilde mümkündür; ancak herkes için uygun değildir. Kısa saçta geçiş hattı ve işçilik, ince saçta ağırlık dengesi ekstra planlama gerektirir. Uygunluk bireysel değerlendirme ile belirlenir.',
  },
  {
    question: 'Genel danışmanlık numarası ile İstanbul uygulama hattı aynı mı?',
    answer:
      'Hayır. Türkiye geneli ve Fethiye bilgilendirme hattı 0532 592 88 42 numarasıdır. İstanbul\'da yüz yüze profesyonel uygulama talepleri BERAT KOLUKIRIK\'a ait 0536 507 90 28 hattı üzerinden yönetilir.',
  },
  {
    question: 'Kuaför veya merkez seçerken nelere bakmalıyım?',
    answer:
      'Referans çalışmalar, uygulama sürecinin şeffaf anlatımı, bakım talimatları ve gerçekçi beklenti yönetimi önemlidir. Abartılı vaatler, herkese aynı paket veya tıbbi iddialardan kaçının. Yüz yüze görüşme imkânı değerlendirin.',
  },
];

const schemas = [
  breadcrumbSchema(breadcrumbs),
  articleSchema({ title, description, path }),
  faqSchema(faqs),
];
---

<BaseLayout {title} {description} {path} breadcrumbs={breadcrumbs} schemas={schemas}>
  <Breadcrumb items={breadcrumbs} />
  <PageHero
    title="İstanbul Mikro Saç Kaynak Uygulaması"
    lead="Şehirde yüz yüze profesyonel uygulama düşünenler için yöntem seçimi, uygunluk ve iletişim — sakin, net ve abartısız bir rehber."
  />

  <article class="section">
    <div class="container container--narrow prose">
      <h2>İstanbul'da mikro saç kaynak uygulaması</h2>
      <p>
        Mikro saç kaynak, doğal tellere küçük bağlantı noktalarıyla ek saç
        yerleştirilen bir uzatma yöntemidir. Şehirde bu uygulamayı arayanların
        önce yöntemi anlaması, sonra kendi saç profiline uygunluğu
        değerlendirmesi gerekir. Bu sayfa bilgilendirme ve gerçek yönlendirme
        amacı taşır; genel rehber içeriklerimizden ayrı olarak, yüz yüze
        uygulama talebi olan ziyaretçiler için hazırlandı.
      </p>
      <p>
        Mikro kaynak saç uygulamasında ince bağlantı profili hedeflenir; fakat
        sonuç yalnızca yöntem adına değil, planlama kalitesine bağlıdır. Yanlış
        ağırlık, hızlı paket satışı veya bakım planı olmadan yapılan işlemler
        kısa sürede sorun çıkarabilir. Karar vermeden önce
        <a href="/mikro-kaynak-nedir/">mikro kaynak nedir</a> rehberimizi
        okumanız faydalı olur.
      </p>

      <h2>Mikro kaynak saç kimlere uygundur?</h2>
      <p>
        Orta yoğunlukta, kopma belirtisi olmayan ve düzenli bakıma uyum
        sağlayabilecek saç profillerinde daha öngörülebilir sonuç alınabilir.
        Aktif saç dökülmesi, saç derisinde irritasyon veya yoğun kimyasal işlem
        geçmişi varsa erteleme veya alternatif yöntem düşünülebilir. Herkes
        mikro kaynak için uygun değildir — bu genel bir kuraldır ve şehirden
        bağımsızdır.
      </p>
      <p>
        Ayrıntılı kriterler için
        <a href="/mikro-kaynak-kimlere-uygundur/">kimlere uygundur</a>
        sayfamıza bakabilirsiniz. Profesyonel uygulama öncesinde mevcut
        uzunluk, yoğunluk hissi ve hedeflediğiniz görünüm netleştirilmelidir.
      </p>

      <h2>İstanbul'da saç kaynak yöntemi seçerken nelere dikkat edilmeli?</h2>
      <p>
        Profesyonel saç kaynak uygulamasında yöntem; doğal yoğunluk, kesim
        şekli, hedef uzunluk, tellerin inceliği ve günlük bakım
        alışkanlıklarınıza göre seçilmelidir. Mikro kapsül kaynak ince profil
        sunabilir; keratin kaynak farklı bir bağlantı mantığı kullanır.
        Nanofilament kaynak ise düz profil hedefleyen senaryolarda
        değerlendirilebilir. “Tek doğru yöntem” yoktur.
      </p>
      <p>
        Kuaför veya uygulayıcı seçerken şeffaf anlatım, gerçek referans
        örnekleri ve bakım sonrası takip süreci önemlidir. Abartılı “en iyi
        merkez” iddiaları yerine, size özel plan sunulup sunulmadığına odaklanın.
        Tavsiye arayanlar için: tanıdık referansı olan, süreci sakinçe anlatan
        ve uygunluk konusunda net konuşan uygulayıcılar genellikle daha güven
        vericidir — sahte yorum veya uydurma referans üretmiyoruz; kendi
        araştırmanızı yapmanızı öneririz.
      </p>

      <h2>Mikro saç kaynak fiyatları İstanbul'da neden kişiye göre değişir?</h2>
      <p>
        Şehirde fiyatlar yalnızca gram başına hesaplanmaz. Mevcut saç
        uzunluğu, hedeflenen hacim, harmanlama ihtiyacı, uygulama süresi, saç
        kalitesi ve yenileme aralıkları maliyeti birlikte belirler. Kısa saçta
        işçilik payı malzemeden daha baskın olabilir. Telefonda tek rakam
        vermek çoğu zaman yanıltıcıdır; ön bilgi sonrası makul bir aralık
        konuşulabilir.
      </p>
      <p>
        Genel fiyatlandırma mantığı için
        <a href="/mikro-kaynak-fiyatlari/">fiyat rehberimizi</a> inceleyin.
        İstanbul uygulamasında da aynı prensipler geçerlidir; lokasyon tek başına
        fiyatı açıklamaz.
      </p>

      <h2>Kısa saçta ve ince saçta mikro kaynak planlaması</h2>
      <p>
        Kısa kesimlerde geçiş hattının gizlenmesi ve katman uyumu ekstra emek
        gerektirir. İnce telli saçlarda ise ağırlık kontrolü belirleyicidir;
        fazla yoğunluk hem konforu hem görünümü olumsuz etkileyebilir. Her iki
        profilde de aşamalı bir plan bazen tek seferde iddialı bir dönüşümden
        daha sürdürülebilir sonuç verir.
      </p>
      <ul>
        <li>
          <a href="/kisa-saca-mikro-kaynak/">Kısa saça mikro kaynak</a> — harmanlama
          ve işçilik
        </li>
        <li>
          <a href="/ince-sacta-mikro-kaynak/">İnce saçta mikro kaynak</a> — yoğunluk
          ve ağırlık dengesi
        </li>
      </ul>

      <h2>Mikro kaynak, keratin kaynak ve mikro kapsül kaynak farkları</h2>
      <p>
        Mikro kaynak ve mikro kapsül kaynak küçük bağlantı noktası hedefler.
        Keratin kaynak ergimiş keratin boncuğu kullanır; profil genellikle daha
        belirgindir. Seçim kişiseldir: ince saç, kısa kesim veya yoğun fön
        alışkanlığı farklı yöntemleri öne çıkarabilir. Karşılaştırma tablosu ve
        seçim kriterleri için
        <a href="/mikro-kaynak-keratin-nanofilament-farki/">yöntem farkları</a>
        sayfamıza bakın.
      </p>

      <h2>İstanbul profesyonel uygulama iletişimi</h2>
      <p>
        Şehirde mikro saç kaynak ve diğer saç kaynak yöntemleri için yüz yüze
        profesyonel uygulama talep eden müşteriler {CONTACT_ISTANBUL.name} üzerinden
        yönlendirilir. Bu kanal, Türkiye geneli bilgilendirme hattından (
        {CONTACT_GENERAL.phoneDisplay}) ayrıdır; iki numara karıştırılmamalıdır.
      </p>

      <div class="contact-block">
        <p class="contact-block__label">Profesyonel uygulama — yalnızca İstanbul talepleri</p>
        <p class="contact-block__name">{CONTACT_ISTANBUL.name}</p>
        <p class="contact-block__phone">
          <a href={telUrl(CONTACT_ISTANBUL.phoneE164)}>
            +90 {CONTACT_ISTANBUL.phoneDisplay.replace(/^0/, '')}
          </a>
          <span class="contact-block__note">Telefon ve WhatsApp</span>
        </p>
        <div class="contact-block__actions">
          <a
            href={whatsappUrl(undefined, 'istanbul')}
            class="btn btn--whatsapp"
            rel="noopener noreferrer"
          >
            WhatsApp ile Yazın
          </a>
          <a href={telUrl(CONTACT_ISTANBUL.phoneE164)} class="btn btn--secondary">
            Telefon Et
          </a>
        </div>
      </div>

      <p>
        Fethiye ve Ölüdeniz odaklı bilgilendirme ve ön danışmanlık için
        <a href={CONTACT_FETHIYE.pagePath}>Fethiye rehber sayfamızdaki</a> genel
        hattı ({CONTACT_GENERAL.phoneDisplay}) kullanın. Lokasyon seçimi doğal bir
        tercihtir; farklı şehirler için ayrı rehber sayfaları spam bağlantı ağı
        oluşturmaz, yalnızca ihtiyacınıza uygun kanala yönlendirir.
      </p>

      <div class="callout">
        <p>
          <strong>Şeffaflık:</strong> Bu sayfa gerçek hizmet yönlendirmesi içerir.
          Fiziksel adres bilgisi netleşene kadar burada paylaşılmaz; randevu ve
          konum detayı doğrudan iletişimde netleştirilir.
        </p>
      </div>

      <h2>Sık sorulan sorular</h2>
      <FAQList faqs={faqs} />
    </div>
  </article>

  <RelatedLinks links={guideLinks} exclude={path} />
</BaseLayout>

<style>
  .contact-block {
    margin: var(--space-lg) 0;
    padding: var(--space-lg);
    background: var(--color-bg-elevated);
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-md);
  }

  .contact-block__label {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-text-light);
    margin: 0 0 var(--space-xs);
  }

  .contact-block__name {
    font-family: var(--font-serif);
    font-size: 1.5rem;
    margin: 0 0 var(--space-sm);
  }

  .contact-block__phone {
    margin: 0 0 var(--space-md);
  }

  .contact-block__phone a {
    font-size: 1.125rem;
    text-decoration: none;
    color: var(--color-text);
  }

  .contact-block__note {
    display: block;
    font-size: 0.875rem;
    color: var(--color-text-muted);
    margin-top: 0.25rem;
  }

  .contact-block__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
  }
</style>
