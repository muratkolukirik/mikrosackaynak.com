---
/**
 * SACH_SALON_PRICES_2026_V3
 * Customer-facing Fethiye salon prices — reads master JSON.
 * Do not edit euro figures here; update salon-prices-2026.json (and the master repo copy).
 * Do NOT render extensions.tresButterflyWeft.internal in public templates.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import PageHero from '../../components/PageHero.astro';
import PremiumCTA from '../../components/PremiumCTA.astro';
import RelatedLinks from '../../components/RelatedLinks.astro';
import { guideLinks } from '../../data/navigation';
import { CONTACT_FETHIYE } from '../../data/site';
import prices from '../../data/salon-prices-2026.json';
import {
  breadcrumbSchema,
  articleSchema,
  type FAQEntry,
} from '../../utils/schema';

const path = '/fethiye-salon-uygulama-fiyatlari/';
const title = '2026 Fethiye Salon Uygulama Fiyatları';
const description =
  "SACH & Vogue Hair 2026 Fethiye / Ölüdeniz salon uygulama fiyatları. KDV dahil: Keratin €600, Mikro Keratin €650, Nanofilament® €950, Bant €600, Tres & Butterfly Weft 500 €'dan başlayan paket.";

const breadcrumbs = [
  { name: 'Ana Sayfa', path: '/' },
  { name: 'Fethiye Salon Uygulama Fiyatları', path },
];

const faqs: FAQEntry[] = [
  {
    question: 'Fiyatlar KDV dahil mi?',
    answer: 'Evet. Bu sayfadaki tüm salon uygulama fiyatları Türkiye KDV’si dahil (KDV Dahil) gösterilir.',
  },
  {
    question: 'Hibrit Nanofilament® paket fiyatı neden yok?',
    answer: prices.hybrid.pricingNote.tr,
  },
  {
    question: 'Yalnızca işçilik fiyatına saç dahil mi?',
    answer: prices.labourOnly.note.tr,
  },
  {
    question: "Tres & Butterfly Weft 500 € sabit 100 g fiyatı mı?",
    answer:
      'Hayır. 500 €, 100 grama kadar ilk uygulama için minimum başlangıç salon paketidir; evrensel sabit 100 g ürün fiyatı değildir. 100 gramın üzerindeki ilave saç, seçilen uzunluk ve gerçek gramaja göre hesaplanır.',
  },
];

const ext = prices.extensions;
const labour = prices.labourOnly.services;
const rem = prices.removal;

function labourPrice(s: (typeof labour)[number]): string {
  const u = s.unit.tr;
  if (typeof s.priceEur === 'number') {
    const n = Number.isInteger(s.priceEur) ? String(s.priceEur) : String(s.priceEur).replace('.', ',');
    return u === 'uygulama' ? `€${n}` : `€${n} / ${u}`;
  }
  const min = String(s.priceEur.min).replace('.', ',');
  const max = String(s.priceEur.max).replace('.', ',');
  return u === 'uygulama' ? `€${min}–€${max}` : `€${min}–€${max} / ${u}`;
}

function colourPrice(s: (typeof prices.colourServices.services)[number]): string {
  if ('display' in s && s.display?.tr) return s.display.tr;
  return `€${s.priceEur.min}–€${s.priceEur.max}`;
}

const schemas = [
  breadcrumbSchema(breadcrumbs),
  articleSchema({ title, description, path, dateModified: '2026-08-31' }),
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: 'Keratin Saç Kaynak Paketi',
    provider: { '@type': 'HairSalon', name: CONTACT_FETHIYE.brandName },
    areaServed: 'Fethiye',
    offers: {
      '@type': 'Offer',
      price: String(ext.keratin.packagePriceEur),
      priceCurrency: 'EUR',
      description: 'KDV dahil 100 g paket',
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: 'Mikro Keratin Saç Kaynak Paketi',
    provider: { '@type': 'HairSalon', name: CONTACT_FETHIYE.brandName },
    areaServed: 'Fethiye',
    offers: {
      '@type': 'Offer',
      price: String(ext.microKeratin.packagePriceEur),
      priceCurrency: 'EUR',
      description: 'KDV dahil 100 g paket',
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: 'Nanofilament® Saç Kaynak Paketi',
    provider: { '@type': 'HairSalon', name: CONTACT_FETHIYE.brandName },
    areaServed: 'Fethiye',
    offers: {
      '@type': 'Offer',
      price: String(ext.nanofilament.packagePriceEur),
      priceCurrency: 'EUR',
      description: 'KDV dahil 100 g paket',
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: 'Bant Kaynak Paketi',
    provider: { '@type': 'HairSalon', name: CONTACT_FETHIYE.brandName },
    areaServed: 'Fethiye',
    offers: {
      '@type': 'Offer',
      price: String(ext.tapeIn.packagePriceEur),
      priceCurrency: 'EUR',
      description: 'KDV dahil 100 g paket',
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: 'Tres & Butterfly Weft Saç Kaynak Paketi',
    provider: { '@type': 'HairSalon', name: CONTACT_FETHIYE.brandName },
    areaServed: 'Fethiye',
    description: ext.tresButterflyWeft.summary.tr,
    offers: {
      '@type': 'Offer',
      price: String(ext.tresButterflyWeft.startingPriceEur),
      priceCurrency: 'EUR',
      priceSpecification: {
        '@type': 'PriceSpecification',
        price: String(ext.tresButterflyWeft.startingPriceEur),
        priceCurrency: 'EUR',
        minPrice: String(ext.tresButterflyWeft.startingPriceEur),
        valueAddedTaxIncluded: true,
        description: 'Başlangıç / minimum salon paketi (500 €\'dan). Evrensel sabit 100 g ürün fiyatı değildir.',
      },
    },
  },
];
---

<BaseLayout {title} {description} {path} breadcrumbs={breadcrumbs} schemas={schemas}>
  <Breadcrumb items={breadcrumbs} />
  <PageHero
    title="2026 Fethiye Salon Uygulama Fiyatları"
    kicker={`SACH & Vogue Hair · ${prices.locationDisplay?.tr ?? 'Fethiye / Ölüdeniz'} · KDV Dahil`}
    lead="Profesyonel salon uygulama paketleri. Keratin, Mikro Keratin, Nanofilament® ve Bant paketleri nihai KDV dahil 100 g toplamıdır. Tres & Butterfly Weft 500 €'dan başlayan (100 grama kadar) başlangıç salon paketidir."
  />

  <article class="section" data-price-version={prices.masterPriceVersion}>
    <div class="container container--narrow prose">
      <p class="short-answer">
        <strong>KDV Dahil</strong> · Master: {prices.masterPriceVersion}
      </p>

      <h2>Saç Kaynak Paketleri</h2>
      <div class="table-wrap">
        <table>
          <thead>
            <tr><th>Yöntem</th><th>Referans</th><th>Paket</th></tr>
          </thead>
          <tbody>
            <tr>
              <td>{ext.keratin.name.tr}</td>
              <td>100 g / {ext.keratin.strands} adet</td>
              <td>€{ext.keratin.packagePriceEur}</td>
            </tr>
            <tr>
              <td>{ext.microKeratin.name.tr}</td>
              <td>100 g / {ext.microKeratin.strands} adet</td>
              <td>€{ext.microKeratin.packagePriceEur}</td>
            </tr>
            <tr>
              <td>{ext.nanofilament.name.tr}</td>
              <td>100 g / {ext.nanofilament.strands} adet</td>
              <td>€{ext.nanofilament.packagePriceEur}</td>
            </tr>
            <tr>
              <td>{ext.tapeIn.name.tr}</td>
              <td>100 g / yakl. {ext.tapeIn.pieces} adet / {ext.tapeIn.pairs} çift</td>
              <td>€{ext.tapeIn.packagePriceEur}</td>
            </tr>
            <tr>
              <td>{ext.tresButterflyWeft.name.tr}</td>
              <td>{ext.tresButterflyWeft.publicReference.tr}</td>
              <td>{ext.tresButterflyWeft.publicDisplay.tr}</td>
            </tr>
          </tbody>
        </table>
      </div>
      <h3>Pakete dahil</h3>
      <ul>
        {prices.packageIncludes.tr.map((item) => <li>{item}</li>)}
      </ul>
      <p>{prices.notes.tr}</p>

      <h2 id="tres-butterfly-weft">{ext.tresButterflyWeft.publicCopy.tr.title}</h2>
      <p class="price-start">{ext.tresButterflyWeft.publicDisplay.tr}</p>
      <p><strong>KDV Dahil</strong> · {ext.tresButterflyWeft.publicReference.tr}</p>
      <p>{ext.tresButterflyWeft.publicCopy.tr.lead}</p>
      {ext.tresButterflyWeft.publicCopy.tr.body.map((para) => <p>{para}</p>)}
      <p class="muted">{ext.tresButterflyWeft.summary.tr}</p>

      <h2>{prices.hybrid.title.tr}</h2>
      <p>{prices.hybrid.intro.tr}</p>
      {prices.hybrid.combinations.map((c) => (
        <div>
          <h3>{c.name.tr}</h3>
          <p>{c.description.tr}</p>
        </div>
      ))}
      <p><strong>{prices.hybrid.pricingLabel.tr}.</strong> <em>{prices.hybrid.pricingNote.tr}</em></p>

      <h2>{prices.labourOnly.title.tr}</h2>
      <p>{prices.labourOnly.note.tr}</p>
      <p class="muted">{prices.labourOnly.weftPackageDistinction.tr}</p>
      <div class="table-wrap">
        <table>
          <thead>
            <tr><th>Hizmet</th><th>Ücret</th></tr>
          </thead>
          <tbody>
            {labour.map((s) => (
              <tr>
                <td>{s.name.tr}</td>
                <td>{labourPrice(s)}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <h2>{rem.title.tr}</h2>
      <p>{rem.note.tr}</p>
      <div class="table-wrap">
        <table>
          <thead>
            <tr><th>Hizmet</th><th>Ücret</th></tr>
          </thead>
          <tbody>
            <tr>
              <td>Keratin / Mikro Keratin Söküm</td>
              <td>€{rem.keratinMicro.removalPerStrandEur} / adet</td>
            </tr>
            <tr>
              <td>Keratin Yenileme<br /><span class="muted">{rem.keratinMicro.renewalIncludes.tr}</span></td>
              <td>€{rem.keratinMicro.renewalPerStrandEur} / adet</td>
            </tr>
            <tr>
              <td>Keratin Yalnızca Yeniden Uçlama</td>
              <td>€{String(rem.keratinMicro.reTippingOnlyEur.min).replace('.', ',')}–€{String(rem.keratinMicro.reTippingOnlyEur.max).replace('.', ',')} / adet</td>
            </tr>
            <tr>
              <td>Bant Kaynak Söküm</td>
              <td>€{rem.tapeIn.removalPerPairEur} / çift</td>
            </tr>
            <tr>
              <td>Bant Kaynak Yenileme<br /><span class="muted">{rem.tapeIn.renewalIncludes.tr}</span></td>
              <td>€{rem.tapeIn.renewalPerPairEur} / çift</td>
            </tr>
            <tr>
              <td>Weft / Tres Söküm</td>
              <td>€{rem.weft.removalEur.min}–€{rem.weft.removalEur.max}</td>
            </tr>
            <tr>
              <td>Weft / Tres Yenileme</td>
              <td>€{rem.weft.renewalEur.min}–€{rem.weft.renewalEur.max}</td>
            </tr>
          </tbody>
        </table>
      </div>
      <p>{rem.explanatory.tr}</p>

      <h2>Minimum Hizmet Ücreti</h2>
      <p>€{prices.minimumServiceChargeEur} KDV Dahil — küçük söküm, düzeltme, ayarlama veya bakım randevusu için minimum ücret.</p>

      <h2>Profesyonel Saç Renk Hizmetleri</h2>
      <div class="table-wrap">
        <table>
          <thead>
            <tr><th>Hizmet</th><th>Fiyat aralığı</th></tr>
          </thead>
          <tbody>
            {prices.colourServices.services.map((s) => (
              <tr>
                <td>{s.name.tr}</td>
                <td>{colourPrice(s)}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p>{prices.colourServices.note.tr}</p>

      <p>
        İngilizce kanonik liste:{' '}
        <a href={prices.canonicalUrl} rel="noopener">sachvoguehair.com Fethiye salon prices</a>
      </p>
    </div>
  </article>

  <PremiumCTA
    title="Fethiye randevu ve saç analizi"
    text="Paket seçimi ve hibrit plan için fotoğrafla ön analiz sonrası net teklif paylaşılır."
    message="Merhaba, 2026 Fethiye salon uygulama fiyatları hakkında bilgi almak istiyorum."
  />
  <RelatedLinks links={guideLinks} exclude={path} />
</BaseLayout>

<style>
  .table-wrap {
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    margin: 1.25rem 0;
  }
  table {
    width: 100%;
    min-width: 480px;
    border-collapse: collapse;
  }
  th,
  td {
    text-align: left;
    padding: 0.75rem 0.85rem;
    border-bottom: 1px solid #d9d1c5;
    vertical-align: top;
  }
  th {
    text-transform: uppercase;
    letter-spacing: 0.12em;
    font-size: 0.72rem;
    color: #6d6a64;
    background: #eae3d8;
  }
  .muted {
    color: #6d6a64;
    font-size: 0.92rem;
  }
  .price-start {
    font-size: 1.35rem;
    font-weight: 600;
    margin: 0.35rem 0;
  }
</style>
