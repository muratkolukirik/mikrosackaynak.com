---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import PageHero from '../components/PageHero.astro';
import CTAWhatsApp from '../components/CTAWhatsApp.astro';
import RelatedLinks from '../components/RelatedLinks.astro';
import FAQList from '../components/FAQList.astro';
import { guideLinks } from '../data/navigation';
import { PILLAR_PATH } from '../data/site';
import {
  breadcrumbSchema,
  articleSchema,
  faqSchema,
  type FAQEntry,
} from '../utils/schema';

const path = '/mikro-kaynak-bakimi/';
const title = 'Mikro Kaynak Bakımı';
const description =
  'Mikro kaynak saç bakımı: günlük rutin, yıkama, fırçalama, uyku ve yenileme aralıkları. Bağlantı ömrünü uzatmak için pratik öneriler.';

const breadcrumbs = [
  { name: 'Ana Sayfa', path: '/' },
  { name: 'Mikro Kaynak Bakımı', path },
];

const faqs: FAQEntry[] = [
  {
    question: 'Mikro kaynak saç ne kadar süre kullanılır?',
    answer:
      'Kullanım süresi bakım disiplininize, saç büyüme hızınıza ve günlük alışkanlıklarınıza bağlıdır. Kesin ay garantisi vermek doğru değildir. Düzenli kontrol seansları görünümü ve konforu korumaya yardımcı olur. Detaylı kullanım süresi rehberi yakında yayınlanacaktır.',
  },
  {
    question: 'Mikro kaynak saç kaç günde bir yıkanmalı?',
    answer:
      'Uygulama sonrası ilk 24–48 saat yıkamaktan kaçının. Sonrasında haftada 2–3 kez veya saç tipinize göre daha seyrek yıkama genellikle yeterlidir. Aşırı yıkama bağlantı noktalarını yorabilir. Uzmanınızın size özel talimatını takip edin.',
  },
  {
    question: 'Mikro kaynak bakımında hangi ürünler kullanılmalı?',
    answer:
      'Sülfatsız veya hafif formüllü şampuan, geniş dişli tarak veya kaynak fırçası tercih edin. Kremsi ürünleri bağlantı noktasına yığmayın. Isı koruyucu ürün fön ve maşa kullanımında faydalıdır. Kimyasal işlem öncesi mutlaka uzmanınıza danışın.',
  },
];

const schemas = [
  breadcrumbSchema(breadcrumbs),
  articleSchema({ title, description, path }),
  faqSchema(faqs),
];
---

<BaseLayout {title} {description} {path} breadcrumbs={breadcrumbs} schemas={schemas}>
  <Breadcrumb items={breadcrumbs} />
  <PageHero
    title="Mikro Kaynak Bakımı"
    lead="İyi bir uygulama kadar önemli olan düzenli bakımdır. Günlük alışkanlıklarınız bağlantı ömrünü ve görünümü doğrudan etkiler."
  />

  <article class="section">
    <div class="container container--narrow prose">
      <div class="short-answer">
        <p class="short-answer__label">Kısa cevap</p>
        <p>
          Mikro kaynak bakımı; nazik yıkama, doğru fırçalama, ısı kontrolü ve
          düzenli kontrol seanslarından oluşur. İlk 48 saat kritiktir; uzun vadede
          bakım disiplininiz bağlantı ömrünü belirler.
        </p>
      </div>

      <h2>İlk günler</h2>
      <p>
        Uygulama sonrası ilk 24–48 saat, bağlantı noktalarının oturması için
        kritik kabul edilir. Uzmanınızın önerdiği süre boyunca saçınızı
        yıkamaktan, aşırı ısıdan ve sıkı topuzdan kaçının. Her uygulayıcı farklı
        talimat verebilir; size özel planı takip edin.
      </p>

      <h2>Yıkama rutini</h2>
      <ul>
        <li>Ilık su kullanın; bağlantı bölgesine agresif masaj yapmayın</li>
        <li>Sülfatsız veya hafif formüllü şampuan tercih edin</li>
        <li>Şampuanı köklerde değil, teller arasında dağıtarak uygulayın</li>
        <li>Kremsi ürünleri bağlantı noktasına yığmayın</li>
        <li>Nazikçe havluyla sıkarak kurulayın; sert ovuşturmayın</li>
      </ul>

      <h2>Fırçalama ve tarak</h2>
      <p>
        Geniş dişli tarak veya özel kaynak fırçası kullanın. Bağlantı noktasından
        başlayarak uçlara doğru açın; zorlanan düğümleri çekerek değil, parça
        parça çözerek giderin. Islak saçta daha dikkatli olun.
      </p>

      <h2>Isı ve kimyasal işlemler</h2>
      <p>
        Düzenli fön, maşa veya düzleştirici kullanımı telleri yorar. Isı koruyucu
        ürün kullanın ve sıcaklığı düşük–orta aralıkta tutun. Röve, balyaj veya
        açıcı işlemler bağlantı bölgesini etkileyebilir; işlem öncesi uzmanınıza
        danışın.
      </p>

      <h2>Uyku alışkanlıkları</h2>
      <p>
        Sıkı at kuyruğu, sıkı örgü ve sert tokalar bağlantılara baskı uygular.
        Mümkünse gevşek bir topuz veya düşük at kuyruğu tercih edin. İpek veya
        saten yastık kılıfı sürtünmeyi azaltabilir.
      </p>

      <h2>Deniz, güneş ve spor</h2>
      <p>
        Fethiye ve Ölüdeniz gibi sahil bölgelerinde deniz suyu, klor ve yoğun
        güneş telleri kurutabilir. Yüzme sonrası tatlı suyla durulama, UV
        korumalı ürünler ve spor sonrası saçın nemlendirilmesi bakım planının
        parçası olmalıdır.
      </p>

      <h2>Yenileme ve kontrol seansları</h2>
      <p>
        Mikro kaynak kalıcı değildir. Doğal saç büyüdükçe bağlantı noktaları aşağı
        iner; periyodik düzeltme gerekir. Kontrol aralığı; saç büyüme hızınıza,
        bakım disiplininize ve kullanılan yönteme göre değişir — genellikle birkaç
        hafta ile birkaç ay arasında. Düzenli kontrol, kopma ve mat görünümü
        önlemeye yardımcı olur. Uygulama öncesi planlanan gramaj ve adet,
        yenileme aralığını da etkileyebilir —
        <a href="/mikro-kaynak-kac-gram-mi-kac-adet-mi/">gram ve adet rehberimizde</a>
        bu dengeyi anlattık.
      </p>
      <p>
        Mikro kaynak ne kadar süre kullanılır sorusunun ayrıntılı cevabı için
        yakında yayınlanacak kullanım süresi rehberimize bakabilirsiniz.
      </p>

      <h2>Bakım maliyeti ve planlama</h2>
      <p>
        Uzun vadeli maliyet hesabı yaparken yenileme aralıklarını da
        <a href="/mikro-sac-kaynak-fiyatlari/">fiyatlandırma rehberimizdeki</a>
        gibi değerlendirin. İyi bakım, erken yenileme ihtiyacını azaltabilir.
      </p>

      <div class="callout">
        <p>
          Bakım planınız uygulama öncesinde netleştirilmelidir.
          <a href={PILLAR_PATH}>Mikro saç kaynak</a> rehberimizde yöntem
          seçimi ve uygunluk kriterlerini de okumanızı öneririz.
        </p>
      </div>

      <h2>Sık sorulan sorular</h2>
      <FAQList faqs={faqs} />
    </div>
  </article>

  <CTAWhatsApp
    title="Bakım planınız hakkında sorularınız mı var?"
    message="Merhaba, mikro kaynak bakımı hakkında bilgi almak istiyorum."
  />
  <RelatedLinks links={guideLinks} exclude={path} />
</BaseLayout>
