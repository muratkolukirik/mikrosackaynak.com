---
interface FAQ {
  question: string;
  answer: string;
}

interface Props {
  title?: string;
  faqs: FAQ[];
}

const { title = 'Sık sorulan kısa sorular', faqs } = Astro.props;
---

<section class="section">
  <div class="container container--narrow">
    <div class="section-head section-head--center">
      <p class="section-kicker">Hızlı cevaplar</p>
      <h2>{title}</h2>
    </div>
    <div class="mini-faq">
      {
        faqs.map((faq) => (
          <div class="mini-faq__item">
            <h3 class="mini-faq__q">{faq.question}</h3>
            <p class="mini-faq__a">{faq.answer}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>
