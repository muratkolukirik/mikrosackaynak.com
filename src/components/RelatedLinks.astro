---
import type { NavItem } from '../data/navigation';

interface Props {
  title?: string;
  links: NavItem[];
  exclude?: string;
}

const { title = 'İlgili rehber sayfaları', links, exclude } = Astro.props;
const filtered = exclude ? links.filter((l) => l.href !== exclude) : links;
---

{
  filtered.length > 0 && (
    <section class="related section section--muted">
      <div class="container">
        <div class="section-head">
          <p class="section-kicker">Devam edin</p>
          <h2>{title}</h2>
        </div>
        <div class="guide-grid">
          {filtered.slice(0, 4).map((link, i) => (
            <a href={link.href} class="guide-card">
              <span class="guide-card__num">Rehber {String(i + 1).padStart(2, '0')}</span>
              <h3 class="guide-card__title">{link.label}</h3>
              {link.description && <p class="guide-card__desc">{link.description}</p>}
              <span class="guide-card__link">Oku →</span>
            </a>
          ))}
        </div>
      </div>
    </section>
  )
}
