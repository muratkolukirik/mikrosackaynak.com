---
import { CONTACT_FETHIYE, GRAND_SLAM_OFFER, telUrl, whatsappUrl } from '../data/site';

interface Props {
  whatsappMessage?: string;
  showActions?: boolean;
  compact?: boolean;
  buttonLabel?: string;
}

const {
  whatsappMessage = GRAND_SLAM_OFFER.whatsappMessage,
  showActions = true,
  compact = false,
  buttonLabel = GRAND_SLAM_OFFER.ctaLabel,
} = Astro.props;
---

<div class:list={['fethiye-contact', { 'fethiye-contact--compact': compact }]}>
  {!compact && (
    <p class="fethiye-contact__label">{CONTACT_FETHIYE.regionNote}</p>
  )}

  <address class="fethiye-contact__address">
    {!compact && <span class="fethiye-contact__name">{CONTACT_FETHIYE.businessName}</span>}
    <span>{CONTACT_FETHIYE.address.display}</span>
  </address>

  <p class="fethiye-contact__hours">{CONTACT_FETHIYE.openingHours.summary}</p>

  <p class="fethiye-contact__phone">
    <a href={telUrl(CONTACT_FETHIYE.phoneE164)}>
      {CONTACT_FETHIYE.phoneDisplay}
    </a>
    <span class="fethiye-contact__note">Telefon ve WhatsApp</span>
  </p>

  {
    showActions && (
      <div class="fethiye-contact__actions">
        <a
          href={whatsappUrl(whatsappMessage)}
          class="btn btn--whatsapp"
          rel="noopener noreferrer"
        >
          {buttonLabel}
        </a>
        <a href={telUrl(CONTACT_FETHIYE.phoneE164)} class="btn btn--secondary">
          Telefon Et
        </a>
      </div>
    )
  }
</div>
