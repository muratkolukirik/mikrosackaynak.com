---
import { CONTACT_FETHIYE, telUrl, whatsappUrl } from '../data/site';

interface Props {
  whatsappMessage?: string;
  showActions?: boolean;
  compact?: boolean;
}

const {
  whatsappMessage = CONTACT_FETHIYE.whatsappDefaultMessage,
  showActions = true,
  compact = false,
} = Astro.props;
---

<div class:list={['fethiye-contact', { 'fethiye-contact--compact': compact }]}>
  {!compact && (
    <p class="fethiye-contact__label">{CONTACT_FETHIYE.regionNote}</p>
  )}

  <address class="fethiye-contact__address">
    {!compact && <span class="fethiye-contact__name">{CONTACT_FETHIYE.businessName}</span>}
    <span>{CONTACT_FETHIYE.address.display}</span>
  </address>

  <p class="fethiye-contact__hours">{CONTACT_FETHIYE.openingHours.summary}</p>

  <p class="fethiye-contact__phone">
    <a href={telUrl(CONTACT_FETHIYE.phoneE164)}>
      {CONTACT_FETHIYE.phoneDisplay}
    </a>
    <span class="fethiye-contact__note">Telefon ve WhatsApp</span>
  </p>

  {
    showActions && (
      <div class="fethiye-contact__actions">
        <a
          href={whatsappUrl(whatsappMessage)}
          class="btn btn--whatsapp"
          rel="noopener noreferrer"
        >
          WhatsApp ile Yazın
        </a>
        <a href={telUrl(CONTACT_FETHIYE.phoneE164)} class="btn btn--secondary">
          Telefon Et
        </a>
      </div>
    )
  }
</div>

<style>
  .fethiye-contact {
    margin: var(--space-lg) 0;
    padding: var(--space-lg);
    background: var(--color-bg-elevated);
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-md);
  }

  .fethiye-contact--compact {
    margin: var(--space-md) 0 0;
    padding: 0;
    background: transparent;
    border: none;
  }

  .fethiye-contact__label {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-text-light);
    margin: 0 0 var(--space-sm);
  }

  .fethiye-contact__address {
    font-style: normal;
    line-height: 1.6;
    color: var(--color-text-muted);
    margin: 0 0 var(--space-sm);
  }

  .fethiye-contact__name {
    display: block;
    font-family: var(--font-serif);
    font-size: 1.25rem;
    color: var(--color-text);
    margin-bottom: var(--space-xs);
  }

  .fethiye-contact__hours {
    font-size: 0.9375rem;
    color: var(--color-text-muted);
    margin: 0 0 var(--space-md);
  }

  .fethiye-contact__phone {
    margin: 0 0 var(--space-md);
  }

  .fethiye-contact__phone a {
    font-family: var(--font-serif);
    font-size: 1.2rem;
    text-decoration: none;
    color: var(--color-text);
  }

  .fethiye-contact__note {
    display: block;
    font-size: 0.875rem;
    color: var(--color-text-light);
    margin-top: 0.25rem;
  }

  .fethiye-contact__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
  }
</style>
