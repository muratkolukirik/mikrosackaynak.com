---
import { GRAND_SLAM_OFFER, whatsappUrl } from '../data/site';

interface Props {
  title?: string;
  text?: string;
  message?: string;
  buttonLabel?: string;
  sub?: string;
  kicker?: string;
}

const {
  title = GRAND_SLAM_OFFER.name,
  text = GRAND_SLAM_OFFER.promise,
  message = GRAND_SLAM_OFFER.whatsappMessage,
  buttonLabel = GRAND_SLAM_OFFER.ctaLabel,
  sub = GRAND_SLAM_OFFER.trustLine,
  kicker = GRAND_SLAM_OFFER.name,
} = Astro.props;
---

<section class="premium-cta">
  <div class="container">
    <div class="premium-cta__inner">
      <div class="premium-cta__content">
        <p class="section-kicker">{kicker}</p>
        <h2 class="premium-cta__title">{title}</h2>
        <p class="premium-cta__text">{text}</p>
      </div>
      <div class="premium-cta__action">
        <a
          href={whatsappUrl(message)}
          class="btn btn--whatsapp btn--lg"
          rel="noopener noreferrer"
        >
          {buttonLabel}
        </a>
        {sub && <p class="premium-cta__sub">{sub}</p>}
      </div>
    </div>
  </div>
</section>
