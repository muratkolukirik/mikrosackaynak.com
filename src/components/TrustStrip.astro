---
interface TrustItem {
  label: string;
  value: string;
}

interface Props {
  items: TrustItem[];
}

const { items } = Astro.props;
---

<section class="trust-strip" aria-label="Güven göstergeleri">
  <div class="container">
    <div class="trust-strip__grid">
      {items.map((item) => (
        <div class="trust-strip__item">
          <p class="trust-strip__label">{item.label}</p>
          <p class="trust-strip__value">{item.value}</p>
        </div>
      ))}
    </div>
  </div>
</section>
