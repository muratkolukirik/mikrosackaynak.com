---
import { SITE } from '../data/site';
import { primaryNav } from '../data/navigation';

interface Props {
  currentPath: string;
}

const { currentPath } = Astro.props;
---

<header class="header">
  <div class="container header__inner">
    <a href="/" class="header__brand">
      <span class="header__brand-name">{SITE.name}</span>
      <span class="header__brand-tag">{SITE.tagline}</span>
    </a>

    <button
      class="header__toggle"
      type="button"
      aria-expanded="false"
      aria-controls="site-nav"
      aria-label="Menüyü aç"
    >
      <span></span>
      <span></span>
    </button>

    <nav id="site-nav" class="header__nav" aria-label="Ana menü">
      <ul class="header__nav-list">
        {
          primaryNav.map((item) => (
            <li>
              <a
                href={item.href}
                class:list={['header__nav-link', { 'is-active': currentPath === item.href }]}
                aria-current={currentPath === item.href ? 'page' : undefined}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: rgba(250, 248, 245, 0.92);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--color-border-subtle);
  }

  .header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-md);
    min-height: var(--header-height);
  }

  .header__brand {
    text-decoration: none;
    color: var(--color-text);
    flex-shrink: 0;
  }

  .header__brand-name {
    display: block;
    font-family: var(--font-serif);
    font-size: 1.25rem;
    font-weight: 500;
    line-height: 1.2;
  }

  .header__brand-tag {
    display: none;
    font-size: 0.75rem;
    color: var(--color-text-light);
    letter-spacing: 0.04em;
  }

  .header__toggle {
    display: none;
    flex-direction: column;
    gap: 5px;
    padding: 0.5rem;
    background: none;
    border: none;
    cursor: pointer;
  }

  .header__toggle span {
    display: block;
    width: 22px;
    height: 1.5px;
    background: var(--color-text);
  }

  .header__nav-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1rem;
    list-style: none;
    margin: 0;
    padding: 0;
    justify-content: flex-end;
  }

  .header__nav-link {
    font-size: 0.8125rem;
    text-decoration: none;
    color: var(--color-text-muted);
    letter-spacing: 0.02em;
    padding: 0.25rem 0;
    border-bottom: 1px solid transparent;
  }

  .header__nav-link:hover,
  .header__nav-link.is-active {
    color: var(--color-text);
    border-bottom-color: var(--color-accent);
  }

  @media (min-width: 900px) {
    .header__brand-tag {
      display: block;
    }
  }

  @media (max-width: 899px) {
    .header__toggle {
      display: flex;
    }

    .header__nav {
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      background: var(--color-bg-elevated);
      border-bottom: 1px solid var(--color-border-subtle);
      padding: var(--space-sm) var(--space-md);
      display: none;
    }

    .header__nav.is-open {
      display: block;
    }

    .header__nav-list {
      flex-direction: column;
      gap: 0;
    }

    .header__nav-link {
      display: block;
      padding: 0.75rem 0;
      font-size: 0.9375rem;
    }
  }
</style>

<script>
  const toggle = document.querySelector('.header__toggle');
  const nav = document.querySelector('#site-nav');

  toggle?.addEventListener('click', () => {
    const isOpen = nav?.classList.toggle('is-open');
    toggle.setAttribute('aria-expanded', String(isOpen));
    toggle.setAttribute('aria-label', isOpen ? 'Menüyü kapat' : 'Menüyü aç');
  });
</script>
