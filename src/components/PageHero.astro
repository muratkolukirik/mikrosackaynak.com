---
interface Props {
  title: string;
  lead?: string;
  image?: { webp: string; jpg: string; alt: string };
  /** Tam genişlik banner: metin üstte, görsel altta */
  layout?: 'default' | 'banner';
}

const { title, lead, image, layout = 'default' } = Astro.props;
const isBanner = layout === 'banner' && image;
---

<section class="hero">
  <div class="container">
    <div class:list={['hero__inner', { 'hero__inner--with-image': image && !isBanner, 'hero__inner--banner': isBanner }]}>
      <div class="hero__text">
        <h1>{title}</h1>
        {lead && <p class="lead">{lead}</p>}
      </div>
      {
        image && (
          <div class="hero__media">
            <picture>
              <source srcset={image.webp} type="image/webp" />
              <img src={image.jpg} alt={image.alt} loading="eager" decoding="async" />
            </picture>
          </div>
        )
      }
    </div>
  </div>
</section>
