---
interface Props {
  title: string;
  lead?: string;
}

const { title, lead } = Astro.props;
---

<section class="hero">
  <div class="container container--narrow">
    <h1>{title}</h1>
    {lead && <p class="lead">{lead}</p>}
  </div>
</section>

<style>
  .hero {
    padding-block: var(--space-xl) var(--space-lg);
    background: linear-gradient(
      180deg,
      var(--color-bg-elevated) 0%,
      var(--color-bg) 100%
    );
  }
</style>
