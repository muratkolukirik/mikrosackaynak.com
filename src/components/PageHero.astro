---
interface Props {
  title: string;
  lead?: string;
  image?: { webp: string; jpg: string; alt: string };
}

const { title, lead, image } = Astro.props;
---

<section class="hero">
  <div class="container">
    <div class:list={['hero__inner', { 'hero__inner--with-image': image }]}>
      <div class="hero__text">
        <h1>{title}</h1>
        {lead && <p class="lead">{lead}</p>}
      </div>
      {
        image && (
          <div class="hero__media">
            <picture>
              <source srcset={image.webp} type="image/webp" />
              <img src={image.jpg} alt={image.alt} loading="eager" decoding="async" />
            </picture>
          </div>
        )
      }
    </div>
  </div>
</section>

<style>
  .hero {
    padding-block: var(--space-xl) var(--space-lg);
    background: linear-gradient(
      180deg,
      var(--color-bg-elevated) 0%,
      var(--color-bg) 100%
    );
  }

  .hero__inner {
    max-width: var(--content-width);
    margin-inline: auto;
  }

  .hero__inner--with-image {
    max-width: var(--max-width);
    display: grid;
    gap: var(--space-lg);
    align-items: center;
    grid-template-columns: 1fr;
  }

  @media (min-width: 900px) {
    .hero__inner--with-image {
      grid-template-columns: 1.1fr 0.9fr;
    }
  }

  .hero__media img {
    width: 100%;
    border-radius: var(--radius-lg);
    border: 1px solid var(--color-border-subtle);
  }
</style>
