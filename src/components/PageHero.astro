---
interface Props {
  title: string;
  lead?: string;
  kicker?: string;
  image?: { webp: string; jpg: string; alt: string };
  layout?: 'default' | 'banner' | 'split';
}

const { title, lead, kicker, image, layout = 'default' } = Astro.props;
const isBanner = layout === 'banner' && image;
const isSplit = layout === 'split' && image;
---

<section class="hero">
  <div class="container">
    <div
      class:list={[
        'hero__inner',
        { 'hero__inner--with-image': image && !isBanner && !isSplit },
        { 'hero__inner--banner': isBanner },
        { 'split-hero__grid': isSplit },
      ]}
    >
      <div class="hero__text">
        {kicker && <p class="hero__kicker">{kicker}</p>}
        <h1>{title}</h1>
        {lead && <p class="lead">{lead}</p>}
      </div>
      {
        image && (
          <div class="hero__media">
            <picture>
              <source srcset={image.webp} type="image/webp" />
              <img src={image.jpg} alt={image.alt} loading="eager" decoding="async" />
            </picture>
          </div>
        )
      }
    </div>
  </div>
</section>
