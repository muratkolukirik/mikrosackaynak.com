---
import { GRAND_SLAM_OFFER, whatsappUrl } from '../data/site';

interface Props {
  title?: string;
  text?: string;
  message?: string;
  variant?: 'default' | 'subtle';
  buttonLabel?: string;
}

const {
  title = GRAND_SLAM_OFFER.name,
  text = GRAND_SLAM_OFFER.promise,
  message = GRAND_SLAM_OFFER.whatsappMessage,
  variant = 'default',
  buttonLabel = GRAND_SLAM_OFFER.ctaLabel,
} = Astro.props;
---

<aside class:list={['cta', { 'cta--subtle': variant === 'subtle' }]}>
  <div class="container container--narrow">
    <div class="cta__inner">
      <div class="cta__content">
        <p class="cta__label">{GRAND_SLAM_OFFER.name}</p>
        <h2 class="cta__title">{title}</h2>
        <p class="cta__text">{text}</p>
      </div>
      <div class="cta__action">
        <a
          href={whatsappUrl(message)}
          class="btn btn--whatsapp"
          rel="noopener noreferrer"
        >
          {buttonLabel}
        </a>
      </div>
    </div>
  </div>
</aside>
